# Copy this file to .env and fill in what you have. Never commit .env to GitHub.
# Keep comments on their own lines: a comment after an empty value becomes the value.

# --- Database: sqlite (default, no setup) or hana
REROUTE_DB=sqlite
# SQL endpoint host from SAP HANA Cloud Central, e.g. xxxxxxxx-xxxx.hana.trial-us10.hanacloud.ondemand.com
HANA_HOST=
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=
# Optional; leave empty to use the user's own schema
HANA_SCHEMA=

# --- SAP Generative AI Hub (values from the SAP AI Core service key)
# clientid
AICORE_CLIENT_ID=
# clientsecret
AICORE_CLIENT_SECRET=
# the key's "url" with /oauth/token added
AICORE_AUTH_URL=
# the key's serviceurls.AI_API_URL with /v2 added
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default
# Orchestration deployment URL (Deployments > defaultOrchestrationConfig > Deployment URL).
# With it set, LLM_MODEL can be any model in the hub, e.g. anthropic--claude-4.5-haiku
ORCHESTRATION_URL=
# Model name as Generative AI Hub lists it
LLM_MODEL=gpt-4o-mini
# Set to off to force the offline templates (backup for the demo)
REROUTE_LLM=on

# --- Autonomy limits for the Policy agent (Indian rupees)
AUTO_COST_LIMIT_INR=100000
BIG_SWITCH_LIMIT_INR=5000000

# --- SAP Business Accelerator Hub sandbox (api.sap.com > log in > open the API page > Show API Key)
S4_SANDBOX_API_KEY=
# Full URL of the purchase order list from the API's Try Out page (OData V4 successor API)
S4_SANDBOX_PO_URL=
